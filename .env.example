# Required
UNISCRIBE_API_KEY=your_api_key_here

# Optional: UniScribe API base URL (default https://api.uniscribe.co)
UNISCRIBE_BASE_URL=https://api.uniscribe.co

# Optional: where transcripts/job-ids are cached (default ./.cache)
CACHE_DIR=./.cache

# Not read directly — the output directory is set in config/default.yaml under output.directory
OUTPUT_DIR=

# Optional: port for the HTTP API server (default 4000)
WEBHOOK_PORT=4000

# Optional: how many renders may run at the same time (default 1)
QUEUE_CONCURRENCY=1

# Optional: public URL this container is reachable at — only required if you
# trigger renders with transcription mode: "webhook"
PUBLIC_BASE_URL=

# Optional: shared secret for the HTTP API (X-API-Key header). If unset the API runs unprotected.
API_KEY=generate_a_long_random_string

# Optional: pino log level (default info)
LOG_LEVEL=info
